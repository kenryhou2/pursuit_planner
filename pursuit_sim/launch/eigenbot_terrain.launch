<launch>
  <!-- ========================= -->
  <!-- Inputs / paths           -->
  <!-- ========================= -->

  <arg name="map_file"
       default="$(find pursuit_planner)/maps/map3.txt" />
  <arg name="heightmap_png"
       default="$(find pursuit_sim)/worlds/heightmap_map3.png" />
  <arg name="world_path"
       default="$(find pursuit_sim)/worlds/terrain_world.world" />

  <!-- Eigenbot pose in the world -->
  <!-- <arg name="eigenbot_x"     default="0.0" />
  <arg name="eigenbot_y"     default="0.0" />
  <arg name="eigenbot_z"     default="20" />
  <arg name="eigenbot_roll"  default="0.0" />
  <arg name="eigenbot_pitch" default="4.71" />
  <arg name="eigenbot_yaw"   default="0.0" /> -->

  <!-- ========================= -->
  <!-- 1) Generate heightmap    -->
  <!-- ========================= -->

  <node name="generate_heightmap"
        pkg="pursuit_sim"
        type="generate_heightmap.py"
        output="screen"
        respawn="false"
        clear_params="false"
        args="$(arg map_file)
              --heightmap_png=$(arg heightmap_png)
              --world_path=$(arg world_path)
              --max_height=5.0" />

  <!-- ========================= -->
  <!-- 2) Start Gazebo server   -->
  <!-- ========================= -->

  <node name="gazebo"
        pkg="gazebo_ros"
        type="gzserver"
        args="-e ode $(arg world_path)"
        output="screen" />

  <node name="gazebo_gui"
        pkg="gazebo_ros"
        type="gzclient"
        output="screen" />

  <!-- ========================= -->
  <!-- 3) Spawn cube robot      -->
  <!-- ========================= -->

  <node name="spawn_cube_robot"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-sdf
              -file $(find pursuit_sim)/models/cube_robot/model.sdf
              -model cube_robot
              -x 5.0 -y 5.0 -z 2.0 -Y 0.0" />

  <!-- ========================= -->
  <!-- 4) Load Eigenbot URDF    -->
  <!-- ========================= -->


  <!-- ========================= -->
  <!-- 5) Spawn Eigenbot model  -->
  <!-- ========================= -->

  <!-- <node name="spawn_eigenbot"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-urdf
              -param robot_description
              -model eigenbot
              -x $(arg eigenbot_x)
              -y $(arg eigenbot_y)
              -z $(arg eigenbot_z)
              -R $(arg eigenbot_roll)
              -P $(arg eigenbot_pitch)
              -Y $(arg eigenbot_yaw)" /> -->
<!-- 2) Load robot_description from URDF -->
  <param name="robot_description"
         textfile="$(find eigenbot_gazebo)/urdf/actuated_hexapod_v2.urdf" />

  <node name="spawn_eigenbot"
      pkg="gazebo_ros"
      type="spawn_model"
      args="-urdf
            -param robot_description
            -model actuated_hexapod_v2
            -x 0.0 -y 0.0 -z 0.3
            -R 0.0 -P 4.71 -Y 0.0"
      output="screen" />


  <!-- 4) Load ALL control config (PID + controllers) from ONE YAML -->
  <rosparam file="$(find eigenbot_gazebo)/config/eigenbot_control.yaml"
            command="load" />

  <!-- 5) Spawn controllers via controller_manager -->
  <node name="eigenbot_controller_spawner"
        pkg="controller_manager"
        type="spawner"
        args="joint_state_controller
              bendy_joint_M1_S1_position_controller
              bendy_joint_M2_S2_position_controller
              bendy_joint_M3_S3_position_controller
              bendy_joint_M4_S4_position_controller
              bendy_joint_M5_S5_position_controller
              bendy_joint_M6_S6_position_controller
              bendy_joint_M7_S7_position_controller
              bendy_joint_M8_S8_position_controller
              bendy_joint_M9_S9_position_controller
              bendy_joint_M10_S10_position_controller
              bendy_joint_M11_S11_position_controller
              bendy_joint_M12_S12_position_controller
              bendy_joint_M13_S13_position_controller
              bendy_joint_M14_S14_position_controller
              bendy_joint_M15_S15_position_controller
              bendy_joint_M16_S16_position_controller
              bendy_joint_M17_S17_position_controller
              bendy_joint_M18_S18_position_controller"
        output="screen" />

  <!-- 6) Gazebo bridge -->
  <node name="eigenbot_gazebo_bridge"
        pkg="eigenbot_gazebo"
        type="gazebo_bridge.py"
        output="screen" />

  <!-- 7) Low-level legged controller -->
  <node name="eigenbot_legged_controller"
        pkg="eigenbot_gazebo"
        type="legged_joint_controller.py"
        output="screen" />

  <!-- 8) Trajectory follower (high-level /cmd_vel source) -->
  <node name="eigenbot_trajectory_follower"
        pkg="eigenbot_gazebo"
        type="trajectory_follower.py"
        output="screen" />


</launch>
