<launch>
  <!-- ========================= -->
  <!-- Inputs / paths           -->
  <!-- ========================= -->

  <arg name="map_file"
       default="$(find pursuit_planner)/maps/map3.txt" />
  <arg name="heightmap_png"
       default="$(find pursuit_sim)/worlds/heightmap_map3.png" />
  <arg name="world_path"
       default="$(find pursuit_sim)/worlds/terrain_world.world" />

  <!-- robot pose in the world params-->
<arg name="robot_x" default="10.0"/>
<arg name="robot_y" default="-10.0"/>
<arg name="robot_z" default="0.3"/>
<!-- <arg name="robot_roll" default="1.57"/>
<arg name="robot_pitch" default="-1.57"/> -->
<arg name="robot_roll" default="0.0"/>
<arg name="robot_pitch" default="0.0"/>
<arg name="robot_yaw" default="0.0"/>

<param name="robot_start_x" value="$(arg robot_x)"/>
<param name="robot_start_y" value="$(arg robot_y)"/>
<param name="robot_start_z" value="$(arg robot_z)"/>
<param name="robot_start_yaw" value="$(arg robot_yaw)"/>


  <!-- ========================= -->
  <!-- 1) Generate heightmap    -->
  <!-- ========================= -->

  <node name="generate_heightmap"
        pkg="pursuit_sim"
        type="generate_heightmap.py"
        output="screen"
        respawn="false"
        clear_params="false"
        args="$(arg map_file)
              --heightmap_png=$(arg heightmap_png)
              --world_path=$(arg world_path)
              --max_height=5.0" />

  <!-- ========================= -->
  <!-- 2) Start Gazebo server   -->
  <!-- ========================= -->

  <node name="gazebo"
        pkg="gazebo_ros"
        type="gzserver"
        args="-e ode $(arg world_path)"
        output="screen" />

  <node name="gazebo_gui"
        pkg="gazebo_ros"
        type="gzclient"
        output="screen" />

  <!-- ========================= -->
  <!-- 3) Spawn cube robot      -->
  <!-- ========================= -->

  <!-- <node name="spawn_cube_robot"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-sdf
              -file $(find pursuit_sim)/models/cube_robot/model.sdf
              -model cube_robot
              -x 5.0 -y -10.0 -z 2.0 -Y 0.0" /> -->

  <!-- ========================= -->
  <!-- 4) Load robot URDF    -->
  <!-- ========================= -->


  <!-- ========================= -->
  <!-- 5) Spawn robot model  -->
  <!-- ========================= -->
    <!-- 5) Spawn robot model  -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find myrobot_description)/urdf/myrobot.xacro'"/>

  <node name="myrobot_spawn"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-urdf
              -param robot_description
              -model myrobot
              -x $(arg robot_x)
              -y $(arg robot_y)
              -z $(arg robot_z)
              -R $(arg robot_roll)
              -P $(arg robot_pitch)
              -Y $(arg robot_yaw)" />



</launch>
