<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="terrain_world">

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Inlined heightmap model -->
    <model name="terrain_from_map">
      <static>true</static>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>file:///home/hkou/Work/CMU_Biorobotics/eigenbot_ws/src/pursuit_planner/pursuit_sim/worlds/heightmap_map6.png</uri>
              <size>200 200 20.0</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>

        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <uri>file:///home/hkou/Work/CMU_Biorobotics/eigenbot_ws/src/pursuit_planner/pursuit_sim/worlds/heightmap_map6.png</uri>
              <size>200 200 20.0</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
